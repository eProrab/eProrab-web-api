# ===================================================================
# eProrab Web API - Environment Variables Example
# Copy this file to .env for local Docker Compose overrides or use
# these exact variable names in Render (Dashboard -> Environment).
# ===================================================================

# ASP.NET Core Environment (Development / Staging / Production)
ASPNETCORE_ENVIRONMENT=Development

# Database connection string for PostgreSQL
# For Render Production, use the external/internal PostgreSQL URL or connection string.
# In ASP.NET Core, double-underscores (__) represent nested configuration keys.
ConnectionStrings__Default=Host=postgres;Port=5432;Database=eprorab;Username=eprorab;Password=eprorab_dev_password

# JWT Authentication
Jwt__Issuer=eProrab.API
Jwt__Audience=eProrab.Client
Jwt__SigningKey=your_super_secret_jwt_signing_key_at_least_32_characters_long
Jwt__AccessTokenMinutes=30
Jwt__RefreshTokenDays=30

# Initial Admin Seeding (created on first startup if no admin exists)
SeedAdmin__Email=admin@eprorab.az
SeedAdmin__Password=YourSecureAdminPassword123!

# OAuth 2.0 (Google & Facebook)
OAuth__Google__ClientId=your_google_client_id.apps.googleusercontent.com
OAuth__Google__ClientSecret=your_google_client_secret
OAuth__Facebook__AppId=your_facebook_app_id
OAuth__Facebook__AppSecret=your_facebook_app_secret

# Swagger UI (optional: set to true in production if you want Swagger exposed)
ENABLE_SWAGGER=false

# Optional: Custom port if needed (Render automatically sets PORT)
# PORT=8080
